# ─── Backend ────────────────────────────────────────────────────────────────

# Port the backend server listens on
BACKEND_PORT=8000

# ─── Frontend ────────────────────────────────────────────────────────────────

# Port the frontend server listens on
FRONTEND_PORT=3000

# Full URL of the backend (used by the browser to form WebSocket connections).
# In production, replace with your public backend URL.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Disable Next.js anonymous telemetry (1 = disabled)
NEXT_TELEMETRY_DISABLED=1

# ─── Security ─────────────────────────────────────────────────────────────────

# Secret key used to sign and verify JWT session tokens.
# Generate a strong value with: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use the default below in production.
JWT_SECRET=changeme-use-a-real-secret-in-production
